# Copie este arquivo para ".env" (o ".env" real nunca vai para o GitHub) e ajuste os valores.

# Fuso horário usado nas regras de data/hora (padrão: Brasília)
TZ=America/Sao_Paulo

# Até quantos dias à frente o cliente pode agendar
LIMITE_DIAS_AGENDAMENTO=90

# Porta da API (o front-end espera http://localhost:3000/api)
PORT=3000

# De onde o navegador pode chamar a API. "*" libera qualquer origem (só para desenvolvimento).
CORS_ORIGEM=*

# Como a API descobre quem está chamando:
#   fake     -> cabeçalho X-Usuario-Id (só para desenvolvimento e testes)
#   firebase -> token do Firebase Authentication (etapa de integração)
AUTH_MODO=fake

# Login real (usado só quando AUTH_MODO=firebase)
FIREBASE_PROJECT_ID=projeto-ragozzinni
# Para conferir o login, basta o FIREBASE_PROJECT_ID acima. A chave de serviço é OPCIONAL (só será
# necessária para recursos administrativos). Se usar: console > Configurações do projeto > Contas de serviço
# > Gerar nova chave privada; guarde em back-end/credenciais/ (pasta ignorada pelo Git). NUNCA envie ao GitHub.
# FIREBASE_CREDENCIAIS=../credenciais/chave-firebase.json
# Para testar sem o Firebase real, use o emulador (veja o README) e descomente:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# De onde vêm os dados:
#   memoria -> dados de exemplo em memória (perdem-se ao reiniciar)
#   mysql   -> banco MySQL (etapa seguinte)
DADOS_MODO=memoria

# Banco MySQL (usado só quando DADOS_MODO=mysql). Crie o banco com database/criar_banco.sql.
# A senha é a do seu MySQL: preencha só no seu ".env" (que não vai para o GitHub).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Se a senha tiver # ou espaços, coloque entre aspas:  DB_PASSWORD="minha#senha"
DB_PASSWORD=
DB_NAME=Agenda_Facil

# Testes automáticos no MySQL: use um banco SEPARADO cujo nome termina em "_teste" (os testes apagam e recarregam os dados dele).
# Para criá-lo, rode database/criar_banco.sql trocando "Agenda_Facil" por "Agenda_Facil_teste".
